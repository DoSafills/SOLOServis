# Copiar como .env y ajustar con las credenciales reales de la BD.
# La app también funciona pasando estas mismas variables directamente
# como env vars (por ejemplo, vía docker-compose o el shell).

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=product_api
DB_SSLMODE=disable
