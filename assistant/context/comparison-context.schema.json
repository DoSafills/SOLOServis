{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soloservis.local/assistant/comparison-context.schema.json",
  "title": "Contexto de comparación para el asistente",
  "description": "Payload que el backend arma desde PostgreSQL con los productos comparados. No incluye datos de usuario ni el resto del catálogo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "products", "attributes", "specifications"],
  "properties": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 150 }
      }
    },
    "products": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "brand", "model", "bestPrice", "bestStore", "offerCount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "brand": { "type": "string", "maxLength": 150 },
          "model": { "type": "string", "maxLength": 150 },
          "bestPrice": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+$",
            "description": "Menor precio total en CLP, sin separadores. null si no hay ofertas disponibles."
          },
          "bestStore": { "type": ["string", "null"], "maxLength": 150 },
          "offerCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "dataType", "unit", "values", "differs"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 150 },
          "dataType": { "enum": ["string", "integer", "decimal", "boolean", "enum"] },
          "unit": { "type": ["string", "null"], "maxLength": 30 },
          "values": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] },
            "description": "Un valor por producto, en el mismo orden que products[]. null si el producto no tiene el dato."
          },
          "differs": { "type": "boolean" }
        }
      }
    },
    "specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "values", "differs"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "unit": { "type": ["string", "null"], "maxLength": 50 },
          "values": {
            "type": "array",
            "items": { "type": ["string", "null"] },
            "description": "Un valor por producto, en el mismo orden que products[]. null si el producto no tiene el dato."
          },
          "differs": { "type": "boolean" }
        }
      }
    }
  }
}
