{
  "schemaVersion": "1.0",
  "store": {
    "slug": "ripley-cl",
    "name": "Ripley Chile",
    "baseUrl": "https://simple.ripley.cl",
    "storeId": 4
  },
  "match": {
    "hosts": ["simple.ripley.cl"],
    "pathPrefixes": ["/"]
  },
  "listing": {
    "url": "https://simple.ripley.cl/search/refrigerador",
    "root": "a.product-link",
    "pagination": {
      "mode": "next-link",
      "selector": "a[rel=\"next\"]",
      "maxPages": 20
    },
    "allowEmpty": false
  },
  "item": {
    "externalId": { "attribute": "data-id" },
    "externalUrl": { "attribute": "href", "transform": "absolute_url" },
    "fields": {
      "product.name": {
        "selector": ".product-item--name",
        "type": "string",
        "required": true
      },
      "product.brand": {
        "selector": ".product-item--brand",
        "type": "string",
        "transform": "collapse_ws"
      },
      "product.imageUrl": {
        "selector": ".product-image-img",
        "attribute": "src",
        "type": "url",
        "transform": "absolute_url"
      },
      "product.categorySlug": { "value": "refrigeradores", "type": "slug" },
      "product.attributes.capacidad_litros": { "selector": ".product-item--name", "regex": "(\\d{2,4})\\s*(?:lts?|litros?|l)\\b", "type": "integer" },
      "offer.price": {
        "selector": ".product-price-price",
        "type": "money",
        "required": true,
        "currency": "CLP"
      },
      "offer.listPrice": {
        "selector": ".product-price-old-price",
        "type": "money",
        "currency": "CLP"
      },
      "offer.currency": { "value": "CLP", "type": "string" },
      "offer.condition": { "value": "new", "type": "string" },
      "offer.available": {
        "selector": ".product-item--availability",
        "type": "boolean",
        "default": true
      }
    }
  },
  "rules": {
    "dedupeBy": "externalId",
    "rejectIfMissing": ["externalUrl", "product.name", "offer.price"]
  }
}
