generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(150)
  logoUrl    String?   @map("logo_url")
  websiteUrl String?   @map("website_url")
  active     Boolean   @default(true)
  products   Product[]

  @@map("brand")
}

model ProductCategory {
  id               Int               @id @default(autoincrement())
  parentCategoryId Int?              @map("parent_category_id")
  name             String            @db.VarChar(150)
  description      String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  parent           ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         ProductCategory[] @relation("CategoryHierarchy")
  products         Product[]

  @@map("product_category")
}

model Product {
  id                 Int                      @id @default(autoincrement())
  publicId           String                   @default(uuid()) @unique @map("public_id") @db.Uuid
  categoryId         Int                      @map("category_id")
  brandId            Int?
  name               String                   @db.VarChar(255)
  model              String?                  @db.VarChar(150)
  sku                String?                  @unique @db.VarChar(100)
  description        String?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamp(6)
  category           ProductCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  offers             ProductOffer[]

  @@map("product")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageUrl  String  @map("image_url")
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model Store {
  id                   Int            @id @default(autoincrement())
  name                 String         @db.VarChar(150)
  websiteUrl           String?        @map("website_url")
  logoUrl              String?        @map("logo_url")
  rating               Decimal?       @db.Decimal(3, 2)
  reputation           String?        @db.VarChar(100)
  shippingInformation  String?        @map("shipping_information")
  generalConditions    String?        @map("general_conditions")
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  offers               ProductOffer[]

  @@map("store")
}

model ProductOffer {
  id            Int                  @id @default(autoincrement())
  productId     Int                  @map("product_id")
  storeId       Int                  @map("store_id")
  price         Decimal              @db.Decimal(12, 2)
  listPrice     Decimal?             @map("list_price") @db.Decimal(12, 2)
  currency      String               @default("CLP") @db.Char(3)
  shippingCost  Decimal              @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingFree  Boolean              @default(false) @map("shipping_free")
  available     Boolean              @default(true)
  stock         Int?
  condition     String               @default("new") @db.VarChar(20)
  productUrl    String?              @map("product_url")
  lastUpdated   DateTime             @default(now()) @map("last_updated") @db.Timestamp(6)
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  priceHistory  ProductPriceHistory[]

  @@unique([productId, storeId])
  @@map("product_offer")
}

model ProductPriceHistory {
  id             Int          @id @default(autoincrement())
  productOfferId Int          @map("product_offer_id")
  price          Decimal      @db.Decimal(12, 2)
  isPromotional  Boolean      @default(false) @map("is_promotional")
  recordedAt     DateTime     @default(now()) @map("recorded_at") @db.Timestamp(6)
  productOffer   ProductOffer @relation(fields: [productOfferId], references: [id], onDelete: Cascade)

  @@map("product_price_history")
}
