# postgres://postgres:postgres@localhost:5432/soloservis

PORT=8080
FRONTEND_URL=http://localhost:8443

# URL común para llamadas internas; las *_API_URL específicas tienen prioridad.
# Si queda vacía, se usan los defaults locales de cada servicio.
GATEWAY_URL=


# Usa la URL pooled de Neon (host con "-pooler") para la aplicación.
# Reemplaza todos los marcadores por los valores de Neon.
# Codifica caracteres especiales de la contraseña para usarlos en una URL.
DATABASE_URL=postgresql://<NEON_USER>:<URL_ENCODED_PASSWORD>@<NEON_ENDPOINT>-pooler.<REGION>.aws.neon.tech/<DATABASE>?sslmode=require
