# Variables del backend para el asistente. Nunca con prefijo VITE_
# (las VITE_* terminan en el bundle del navegador).

# Proveedor y modelo. Deben coincidir con config/ai.config.json.
# auto = Gemini con AI_API_KEY. Sin clave la ruta responde 503: el asistente no
# arma respuestas por su cuenta.
# Para DeepSeek (formato OpenAI, más barato): AI_PROVIDER=compatible,
# AI_BASE_URL=https://api.deepseek.com/v1 y AI_MODEL=deepseek-chat.
AI_PROVIDER=auto
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=

# Secreto: no se escribe en el repo. En local va en .env (ignorado por git);
# en el clúster UCT vive en el Secret soloservis-ai como AI_API_KEY.
AI_API_KEY=
