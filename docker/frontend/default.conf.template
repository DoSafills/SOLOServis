# Límite de solicitudes del gateway (TAL-201, hallazgo H1 de TAL-195).
# Este archivo se incluye dentro de http {}, por eso las zonas van aquí.
#
# IP real del cliente: el pod recibe la conexión del Ingress (red privada).
# Se confía en X-Forwarded-For solo cuando lo agrega un salto de red privada,
# y real_ip_recursive descarta esos saltos hasta la primera IP pública.
# Si el proxy de la UCT no reenvía la IP del cliente, todos los usuarios
# comparten una sola IP: por eso los límites son holgados y la Auth API
# tiene además su propio límite por email (internal/features/auth.go).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# auth: login y registro (cada uno cuesta un PBKDF2). api: el resto.
limit_req_zone $binary_remote_addr zone=auth:1m rate=20r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_status 429;
limit_req_log_level warn;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Sin la versión de nginx en la cabecera Server ni en las páginas de error.
    server_tokens off;

    # Cabeceras de seguridad (TAL-197). Las locations con add_header propio
    # vuelven a incluir este archivo, porque si no las perderían.
    include /etc/nginx/soloservis-security-headers.conf;

    # Rutas con separadores codificados o segmentos de punto (TAL-197).
    # nginx elige la location con la ruta ya decodificada y normalizada, pero
    # proxy_pass reenvía la original: /offers/1%2F..%2F..%2Ffavorites entraba
    # por /favorites (sin limit_except) y chi la enrutaba a PUT /offers/{id},
    # una ruta que el gateway no publica. Se revisa solo la ruta, antes del "?",
    # así una búsqueda con ".." o "%2F" en la query sigue funcionando.
    # 418 es solo un código interno para saltar a la location que responde 400.
    error_page 418 = @ruta_invalida;
    if ($request_uri ~* "^[^?]*(%2f|%5c|/(\.|%2e){1,2}(/|%2f|%5c|\?|$))") {
        return 418;
    }
    location @ruta_invalida {
        default_type application/problem+json;
        return 400 '{"type":"about:blank","title":"Bad Request","status":400,"detail":"La ruta de la solicitud no es válida.","instance":"","code":"invalid_path","request_id":"$request_id"}\n';
    }

    # Probe de Kubernetes (no toca las APIs).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # APIs por el mismo origen. La plataforma UCT solo permite el path / por
    # hostname en el Ingress, así que el enrutamiento por path se hace aquí:
    # Browser -> Ingress (/) -> frontend (nginx) -> Service de cada API.
    # Cada destino (*_UPSTREAM) lo completa envsubst al arrancar el contenedor:
    # compose -> product-api:8081, ...; k8s dominios -> comercial:8080 (auth -> usuarios:8080);
    # k8s consolidado -> backend:8080.
    # Pricing, User, Notification e Ingestion no se exponen: solo red interna.

    # Catálogo: público solo lectura (las escrituras requieren admin o token y van por la red interna).
    location ~ ^/(products|product-categories|categories)(/.*)?$ {
        limit_except GET { deny all; }
        proxy_pass http://${PRODUCT_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/stores(/.*)?$ {
        limit_except GET { deny all; }
        proxy_pass http://${STORE_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/services(/.*)?$ {
        limit_except GET { deny all; }
        proxy_pass http://${SERVICE_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }

    # Respuesta 429 con el formato problem+json del estándar TAL-78, para
    # que el frontend la trate como cualquier error del backend.
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/problem+json;
        add_header Retry-After 1 always;
        include /etc/nginx/soloservis-security-headers.conf;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Demasiadas solicitudes. Espera un momento y reintenta.","instance":"","code":"rate_limited","request_id":"$request_id"}\n';
    }
    location @auth_rate_limited {
        default_type application/problem+json;
        add_header Retry-After 3 always;
        include /etc/nginx/soloservis-security-headers.conf;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Demasiados intentos de inicio de sesión o registro. Espera unos segundos y reintenta.","instance":"","code":"rate_limited","request_id":"$request_id"}\n';
    }

    # Login y registro: límite estricto por IP además del general.
    location ~ ^/auth/(login|register)$ {
        limit_except POST { deny all; }
        limit_req zone=auth burst=10 nodelay;
        error_page 429 = @auth_rate_limited;
        proxy_pass http://${AUTH_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }

    # Sesión: refresh, logout y validate.
    location ~ ^/auth(/.*)?$ {
        limit_except GET POST { deny all; }
        proxy_pass http://${AUTH_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }

    # Perfil del usuario: nombre y foto. User API valida la sesión en las
    # escrituras; la foto se sirve pública porque un <img> no puede enviar el
    # bearer token. 3m cubre la imagen de 2 MB más el sobre multipart (nginx
    # trae 1m por defecto y rechazaría la subida).
    location ~ ^/users(/.*)?$ {
        client_max_body_size 3m;
        proxy_pass http://${USER_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }

    # Datos del usuario: cada API valida el token de sesión.
    location ~ ^/favorites(/.*)?$ {
        proxy_pass http://${FAVORITES_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/cart(/.*)?$ {
        proxy_pass http://${CART_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/search(/.*)?$ {
        proxy_pass http://${SEARCH_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/comparisons(/.*)?$ {
        proxy_pass http://${COMPARISON_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/reviews(/.*)?$ {
        proxy_pass http://${REVIEW_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }
    location ~ ^/watchlist(/.*)?$ {
        proxy_pass http://${WATCHLIST_UPSTREAM};
        include /etc/nginx/soloservis-proxy.conf;
    }

    # Assets con hash de Vite: cache largo.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/soloservis-security-headers.conf;
    }

    # SPA: cualquier otra ruta sirve index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/soloservis-security-headers.conf;
    }
}
