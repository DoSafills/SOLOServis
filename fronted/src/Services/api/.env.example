# Si la API corre en Docker y se conecta a tu contenedor de Postgres por red
# (mismo docker network), usa el NOMBRE DEL CONTENEDOR db como host:
DATABASE_URL=postgresql://usuario:password@nombre_contenedor_db:5432/nombre_bd

# Si en cambio corres la API directo en tu máquina (npm run dev, sin Docker)
# y tu contenedor de Postgres publica el puerto 5432 al host, usa localhost:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_bd

PORT=4000
